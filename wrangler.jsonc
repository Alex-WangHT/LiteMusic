{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liteplayer",
  "main": "src/library-worker.mjs",
  "compatibility_date": "2026-10-09",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health"] },
  "d1_databases": [{ "binding": "DB", "database_name": "liteplayer", "database_id": "deb97b32-2701-4c45-b391-6ccfa16dcc3b", "migrations_dir": "stream-migrations", "migrations_table": "stream_migrations" }]
}
